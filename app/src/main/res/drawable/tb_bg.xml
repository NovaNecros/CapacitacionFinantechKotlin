<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:color="@color/dorado">
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <stroke
                android:width="0dp"
                android:color="@color/black"/>
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp"/>
        </shape>
    </item>

    <item
        android:state_checked="false"
        android:color="@color/verdeclaro">
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <stroke
                android:width="0dp"
                android:color="@color/black"/>
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp"/>
        </shape>
    </item>

</selector>

